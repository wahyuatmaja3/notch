<Window x:Class="Notch.Views.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Notch Dynamic Island"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Manual"
        Width="230"
        Height="42"
        MouseEnter="Window_MouseEnter"
        MouseLeave="Window_MouseLeave"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Modern Button Style -->
        <Style x:Key="GlassMediaButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#35FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#50FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GlassPlayPauseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource DynamicAccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="playBtnBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect x:Name="playShadow"
                                                  Color="{DynamicResource DynamicAccentColor}"
                                                  BlurRadius="12"
                                                  ShadowDepth="0"
                                                  Opacity="0.6" />
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="playBtnBorder" Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="playBtnBorder" Property="Opacity" Value="0.75" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Main Island Container -->
    <Grid x:Name="RootGrid" Margin="10,4,10,10">
        <!-- Liquid Glass Outer Drop Shadow -->
        <Border x:Name="IslandShadowContainer"
                CornerRadius="24">
            <Border.Effect>
                <DropShadowEffect x:Name="MainDropShadow"
                                  Color="#000000"
                                  BlurRadius="26"
                                  ShadowDepth="4"
                                  Opacity="0.65" />
            </Border.Effect>

            <!-- Outer Glass Rim Border -->
            <Border x:Name="IslandBorder"
                    CornerRadius="24"
                    BorderThickness="1"
                    ClipToBounds="True">
                <Border.BorderBrush>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#55FFFFFF" Offset="0.0" />
                        <GradientStop Color="#20FFFFFF" Offset="0.5" />
                        <GradientStop Color="#0DFFFFFF" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.BorderBrush>

                <!-- Liquid Glass Background Stack -->
                <Grid x:Name="GlassBackdrop">
                    <!-- Base Deep Glass Tint -->
                    <Border Background="#D00A0A0E" />

                    <!-- Dynamic Accent Color Tint (reactive to album art) -->
                    <Border x:Name="AccentTintOverlay"
                            Opacity="0.22"
                            Background="{DynamicResource DynamicAccentBrush}" />

                    <!-- Specular Curved Highlight (Top Glass Glare) -->
                    <Border VerticalAlignment="Top" Height="18" CornerRadius="24,24,0,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#40FFFFFF" Offset="0.0" />
                                <GradientStop Color="#00FFFFFF" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Inner Subtle Rim Glow -->
                    <Border x:Name="InnerGlowBorder"
                            CornerRadius="24"
                            BorderThickness="1"
                            Opacity="0.4"
                            BorderBrush="{DynamicResource DynamicAccentBrush}" />

                    <!-- CONTENT: COLLAPSED VIEW -->
                    <Grid x:Name="CollapsedView"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Center"
                          Height="36"
                          Margin="8,0,8,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left Mini Thumbnail / Equalizer -->
                        <Grid Grid.Column="0" Width="24" Height="24" Margin="4,0,6,0">
                            <!-- Circular Album Art (if available) -->
                            <Border x:Name="CollapsedArtBorder"
                                    CornerRadius="12"
                                    ClipToBounds="True"
                                    Visibility="Collapsed">
                                <Image x:Name="CollapsedArtImage"
                                       Stretch="UniformToFill" />
                            </Border>

                            <!-- Audio Waveform Visualizer -->
                            <StackPanel x:Name="WaveformBars"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <Border x:Name="WaveBar1" Width="3" Height="8" Margin="1,0" CornerRadius="1.5"
                                        Background="{DynamicResource DynamicAccentBrush}" />
                                <Border x:Name="WaveBar2" Width="3" Height="14" Margin="1,0" CornerRadius="1.5"
                                        Background="{DynamicResource DynamicAccentBrush}" />
                                <Border x:Name="WaveBar3" Width="3" Height="10" Margin="1,0" CornerRadius="1.5"
                                        Background="{DynamicResource DynamicAccentBrush}" />
                                <Border x:Name="WaveBar4" Width="3" Height="6" Margin="1,0" CornerRadius="1.5"
                                        Background="{DynamicResource DynamicAccentBrush}" />
                            </StackPanel>
                        </Grid>

                        <!-- Middle Scrolling / Compact Song Title -->
                        <Grid Grid.Column="1" VerticalAlignment="Center" ClipToBounds="True">
                            <TextBlock x:Name="CollapsedTitleText"
                                       Text="Notch Dynamic Island"
                                       Foreground="#F0F0F0"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </Grid>

                        <!-- Right Source / Status Icon -->
                        <StackPanel Grid.Column="2"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="4,0,4,0">
                            <TextBlock x:Name="CollapsedSourceIcon"
                                       Text="🎵"
                                       FontSize="12"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- CONTENT: EXPANDED VIEW -->
                    <Grid x:Name="ExpandedView"
                          Visibility="Collapsed"
                          Opacity="0"
                          Margin="16,14,16,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />  <!-- Track Info & Album Art -->
                            <RowDefinition Height="*" />     <!-- Live Synced Lyrics -->
                            <RowDefinition Height="Auto" />  <!-- Progress Bar -->
                            <RowDefinition Height="Auto" />  <!-- Media Controls -->
                        </Grid.RowDefinitions>

                        <!-- Row 0: Track Info & Album Art -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- High-Res Album Art with Liquid Glass Glow -->
                            <Grid Grid.Column="0" Width="52" Height="52" Margin="0,0,14,0">
                                <!-- Art Glow -->
                                <Border CornerRadius="14"
                                        Background="{DynamicResource DynamicAccentBrush}"
                                        Opacity="0.4">
                                    <Border.Effect>
                                        <BlurEffect Radius="16" />
                                    </Border.Effect>
                                </Border>
                                <!-- Album Art Image -->
                                <Border x:Name="AlbumArtBorder"
                                        CornerRadius="12"
                                        ClipToBounds="True"
                                        BorderThickness="1"
                                        BorderBrush="#33FFFFFF">
                                    <Image x:Name="AlbumArtImage"
                                           Stretch="UniformToFill" />
                                </Border>
                                <!-- Default Music Placeholder -->
                                <Border x:Name="AlbumArtPlaceholder"
                                        CornerRadius="12"
                                        Background="#252530"
                                        BorderThickness="1"
                                        BorderBrush="#33FFFFFF"
                                        Visibility="Visible">
                                    <TextBlock Text="🎵"
                                               FontSize="24"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Title, Artist & Album -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitleText"
                                           Text="No Track Playing"
                                           Foreground="#FFFFFF"
                                           FontSize="15"
                                           FontWeight="Bold"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,2" />
                                <TextBlock x:Name="TrackArtistText"
                                           Text="Waiting for music..."
                                           Foreground="#A0A0B0"
                                           FontSize="12"
                                           FontWeight="Normal"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Top-Right Source Badge & Settings Button -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                                <!-- Source Pill -->
                                <Border x:Name="SourceBadgeBorder"
                                        Background="#1FFFFFFF"
                                        BorderBrush="#25FFFFFF"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="6,2"
                                        Margin="0,0,6,0">
                                    <TextBlock x:Name="SourceBadgeText"
                                               Text="YT Music"
                                               Foreground="{DynamicResource DynamicAccentBrush}"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>

                                <!-- Settings Button -->
                                <Button x:Name="QuickSettingsBtn"
                                        Style="{StaticResource GlassMediaButtonStyle}"
                                        Width="26"
                                        Height="26"
                                        ToolTip="Settings"
                                        Click="QuickSettingsBtn_Click">
                                    <TextBlock Text="⚙" FontSize="12" />
                                </Button>

                                <!-- Collapse Button -->
                                <Button x:Name="CollapseBtn"
                                        Style="{StaticResource GlassMediaButtonStyle}"
                                        Width="26"
                                        Height="26"
                                        Margin="4,0,0,0"
                                        ToolTip="Collapse"
                                        Click="CollapseBtn_Click">
                                    <TextBlock Text="▲" FontSize="10" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Row 1: Live Synced Lyrics -->
                        <Grid Grid.Row="1" Margin="0,10,0,10" MinHeight="62" VerticalAlignment="Center">
                            <!-- When Lyrics Found: 3-line display -->
                            <StackPanel x:Name="LyricsPanel" VerticalAlignment="Center">
                                <!-- Previous Lyric -->
                                <TextBlock x:Name="LyricPrevText"
                                           Text=""
                                           Foreground="#60FFFFFF"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,0,3" />

                                <!-- Active Lyric (Highlighted & Glowing) -->
                                <Border x:Name="ActiveLyricGlowBorder" CornerRadius="8" Padding="6,2">
                                    <TextBlock x:Name="LyricActiveText"
                                               Text="Listening for music &amp; lyrics..."
                                               Foreground="#FFFFFF"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxHeight="44"
                                               TextTrimming="CharacterEllipsis">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="{DynamicResource DynamicAccentColor}"
                                                              BlurRadius="10"
                                                              ShadowDepth="0"
                                                              Opacity="0.75" />
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Border>

                                <!-- Next Lyric -->
                                <TextBlock x:Name="LyricNextText"
                                           Text=""
                                           Foreground="#60FFFFFF"
                                           FontSize="11"
                                           FontWeight="Normal"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Row 2: Progress Bar & Timestamps -->
                        <Grid Grid.Row="2" Margin="0,0,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Modern Track Progress Bar -->
                            <ProgressBar x:Name="TrackProgressBar"
                                         Grid.Row="0"
                                         Height="4"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="0"
                                         Foreground="{DynamicResource DynamicAccentBrush}"
                                         Background="#25FFFFFF"
                                         BorderThickness="0" />

                            <!-- Time Labels -->
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock x:Name="TimeElapsedText"
                                           Text="0:00"
                                           Foreground="#80FFFFFF"
                                           FontSize="10"
                                           HorizontalAlignment="Left" />
                                <TextBlock x:Name="TimeTotalText"
                                           Text="0:00"
                                           Foreground="#80FFFFFF"
                                           FontSize="10"
                                           HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>

                        <!-- Row 3: Control Buttons -->
                        <Grid Grid.Row="3">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <!-- Previous Button -->
                                <Button x:Name="PrevBtn"
                                        Style="{StaticResource GlassMediaButtonStyle}"
                                        Width="38"
                                        Height="34"
                                        Margin="0,0,12,0"
                                        ToolTip="Previous Track"
                                        Click="PrevBtn_Click">
                                    <TextBlock Text="⏮" FontSize="14" />
                                </Button>

                                <!-- Play/Pause Button -->
                                <Button x:Name="PlayPauseBtn"
                                        Style="{StaticResource GlassPlayPauseButtonStyle}"
                                        Width="46"
                                        Height="36"
                                        ToolTip="Play / Pause"
                                        Click="PlayPauseBtn_Click">
                                    <TextBlock x:Name="PlayPauseIconText"
                                               Text="▶"
                                               FontSize="16" />
                                </Button>

                                <!-- Next Button -->
                                <Button x:Name="NextBtn"
                                        Style="{StaticResource GlassMediaButtonStyle}"
                                        Width="38"
                                        Height="34"
                                        Margin="12,0,0,0"
                                        ToolTip="Next Track"
                                        Click="NextBtn_Click">
                                    <TextBlock Text="⏭" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                    </Grid>

                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
